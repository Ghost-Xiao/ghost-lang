{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ghost",
  "scopeName": "source.ghost",
  "fileTypes": ["gh"],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#literals"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#variables"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ghost",
          "match": "//.*$"
        },
        {
          "name": "comment.block.ghost",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            {
              "include": "#comments"
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.ghost",
          "match": "\\b(if|else|for|foreach|in|step|while|do|return|break|continue|try|catch|finally|throw)\\b"
        },
        {
          "name": "keyword.declaration.ghost",
          "match": "\\b(var|const|func|class|extends|namespace|import)\\b"
        },
        {
          "name": "keyword.other.ghost",
          "match": "\\b(true|false|null|this|super|new)\\b"
        },
        {
          "name": "keyword.operator.contains.ghost",
          "match": "\\b(contains)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.ghost",
          "match": "(=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=)"
        },
        {
          "name": "keyword.operator.comparison.ghost",
          "match": "(==|!=|<|>|<=|>=)"
        },
        {
          "name": "keyword.operator.arithmetic.ghost",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.logical.ghost",
          "match": "(&&|\\||!|\\|)"
        },
        {
          "name": "keyword.operator.bitwise.ghost",
          "match": "(&|\\||\\^|~|<<|>>)"
        },
        {
          "name": "keyword.operator.increment-decrement.ghost",
          "match": "(\\+\\+|--)"
        },
        {
          "name": "keyword.operator.range.ghost",
          "match": "(\\.\\.)"
        },
        {
          "name": "keyword.operator.member-access.ghost",
          "match": "(::|\\.)"
        },
        {
          "name": "keyword.operator.ellipsis.ghost",
          "match": "(\\.\\.\\.)"
        },
        {
          "name": "punctuation.terminator.statement.ghost",
          "match": ";"
        },
        {
          "name": "punctuation.separator.comma.ghost",
          "match": ","
        },
        {
          "name": "punctuation.separator.colon.ghost",
          "match": ":"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "string.quoted.double.ghost",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.ghost",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.ghost",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.ghost",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.backtick.ghost",
          "begin": "`",
          "end": "`",
          "patterns": []
        },
        {
          "name": "constant.numeric.float.ghost",
          "match": "\\b\\d+\\.\\d*(?:[eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.hex.ghost",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.integer.octal.ghost",
          "match": "\\b0[oO][0-7]+\\b"
        },
        {
          "name": "constant.numeric.integer.binary.ghost",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.integer.decimal.ghost",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function.definition.ghost",
          "begin": "\\b(func)\\s+(\\w+)\\s*\\(",
          "beginCaptures": {
            "1": { "name": "keyword.declaration.function.ghost" },
            "2": { "name": "entity.name.function.ghost" }
          },
          "end": "\\)",
          "patterns": [
            {
              "include": "#variables"
            },
            {
              "include": "#literals"
            }
          ]
        },
        {
          "name": "meta.function.call.ghost",
          "begin": "(\\w+)\\s*\\(",
          "beginCaptures": {
            "1": { "name": "entity.name.function.ghost" }
          },
          "end": "\\)",
          "patterns": [
            {
              "include": "#variables"
            },
            {
              "include": "#literals"
            },
            {
              "include": "#operators"
            }
          ]
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.ghost",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
